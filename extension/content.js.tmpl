// Auto-click Gemini's permission card ("Allow once") for ONE connector only: @NAME@
// Generated by `mcp-gateway extension` - re-run it after renaming this PC.
(() => {
  const norm = s => (s || "").toLowerCase().replace(/[-_\s]+/g, " ");
  const APP = norm("mcp-@NAME@");
  const handled = new WeakSet();
  const log = (...a) => console.log("[gw-autoallow]", ...a);

  function tryClick(btn, n = 0) {
    const off = btn.disabled || btn.getAttribute("aria-disabled") === "true";
    if (off) { if (n < 40) setTimeout(() => tryClick(btn, n + 1), 250); return; }
    btn.click();
    log("clicked", btn.innerText.trim());
  }

  function scan() {
    for (const btn of document.querySelectorAll("button")) {
      if (handled.has(btn)) continue;
      if ((btn.innerText || "").trim().toLowerCase() !== "allow once") continue;
      let card = btn.parentElement;
      for (let i = 0; i < 8 && card; i++, card = card.parentElement) {
        const t = card.innerText || "";
        if (t.includes("Let Gemini use")) {
          if (norm(t).includes(APP)) {
            handled.add(btn);
            log("card for", APP + ":", (t.split("\n").find(l => l.includes("Let Gemini use")) || "").slice(0, 100));
            setTimeout(() => tryClick(btn), 200);
          }
          break;
        }
      }
    }
  }
  new MutationObserver(scan).observe(document.documentElement, { childList: true, subtree: true });
  scan();
  log("active, only for", APP);
})();
