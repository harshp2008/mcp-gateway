index 0000000..6e7380e
--- /dev/null
+++ b/checks/label.go
@@ -0,0 +1,60 @@
+package checks
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+
+	"github.com/hoophq/mcpproxy/inspect"
+	"github.com/hoophq/mcpproxy/mcp"
+)
+
+// NameLabel is the check name for the machine-label rewrite.
+const NameLabel = "machine-label"
+
+// Label (local patch) prefixes every tool description with the machine the
+// gateway controls, so a model with several gateways connected cannot mix
+// them up. Set MCP_LABEL to enable (e.g. "MAIN LAPTOP (harsh-hp)").
+type Label struct{ label string }
+
+// NewLabel reads MCP_LABEL.
+func NewLabel() *Label { return &Label{label: os.Getenv("MCP_LABEL")} }
+
+// Name implements inspect.Check.
+func (l *Label) Name() string { return NameLabel }
+
+// Inspect implements inspect.Check.
+func (l *Label) Inspect(_ context.Context, _ inspect.Session, m *inspect.Msg) inspect.Decision {
+	if l.label == "" {
+		return inspect.AllowAll
+	}
+	res, ok := toolsListResult(m)
+	if !ok {
+		return inspect.AllowAll
+	}
+	changed := false
+	for i, raw := range res.Tools {
+		var f map[string]json.RawMessage
+		if json.Unmarshal(raw, &f) != nil {
+			continue
+		}
+		var desc string
+		_ = json.Unmarshal(f["description"], &desc)
+		desc = "[RUNS ON: " + l.label + "] " + desc + " (Executes on " + l.label + " only.)"
+		db, err := json.Marshal(desc)
+		if err != nil {
+			continue
+		}
+		f["description"] = db
+		if out, err := json.Marshal(f); err == nil {
+			res.Tools[i] = out
+			changed = true
+		}
+	}
+	if changed {
+		if b, err := json.Marshal((*mcp.ToolsListResult)(res)); err == nil {
+			m.Env.Result = b
+		}
+	}
+	return inspect.AllowAll
+}
diff --git a/checks/sessiongate.go b/checks/sessiongate.go
new file mode 100644
index 0000000..7e06181
--- /dev/null
+++ b/checks/sessiongate.go
@@ -0,0 +1,201 @@
+package checks
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/hoophq/mcpproxy/config"
+	"github.com/hoophq/mcpproxy/inspect"
+	"github.com/hoophq/mcpproxy/jsonrpc"
+	"github.com/hoophq/mcpproxy/mcp"
+)
+
+// NameSessionGate is the rule name of session-level approval holds. The
+// gateway matches on this prefix to run the per-session approval flow.
+const NameSessionGate = "session-gate"
+
+const metaKeyGate = "checks.sessiongate"
+
+// GateState is the per-session approval state (local patch).
+type GateState struct {
+	flow sync.Mutex // serialises approval prompts: one popup per session
+
+	mu          sync.Mutex
+	until       time.Time // approved until
+	deniedUntil time.Time // auto-deny window after a rejection/timeout
+	client      string
+	ttl         time.Duration
+}
+
+// GateOf returns the session's gate state.
+func GateOf(s inspect.Session) *GateState {
+	return s.Meta(metaKeyGate, func() any { return &GateState{} }).(*GateState)
+}
+
+// Lock/Unlock serialise the approval flow of one session.
+func (g *GateState) Lock()   { g.flow.Lock() }
+func (g *GateState) Unlock() { g.flow.Unlock() }
+
+// Approved reports whether the session currently holds an approval.
+func (g *GateState) Approved() bool {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return time.Now().Before(g.until)
+}
+
+// Denied reports whether the session is inside its post-denial window.
+func (g *GateState) Denied() bool {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return time.Now().Before(g.deniedUntil)
+}
+
+// Approve grants access for the configured TTL.
+func (g *GateState) Approve() {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	g.until = time.Now().Add(g.ttl)
+}
+
+// Deny blocks the session for d, so queued or retried requests do not
+// raise another prompt.
+func (g *GateState) Deny(d time.Duration) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	g.deniedUntil = time.Now().Add(d)
+}
+
+// SessionGate holds every session until a human approves it. initialize,
+// ping and notifications pass so clients can connect; everything else
+// (tools/list, tools/call, resources, prompts, ...) waits for approval.
+type SessionGate struct {
+	enabled bool
+	ttl     time.Duration
+	trust   *trustFile
+}
+
+// trustFile is a cached view of the trust list; it re-reads on mtime change.
+// Unreadable or malformed files mean "nobody is trusted" (fail closed).
+type trustFile struct {
+	path string
+	mu   sync.Mutex
+	mod  time.Time
+	size int64
+	m    map[string]time.Time // subject -> expiry (zero = never)
+}
+
+type trustEntry struct {
+	TrustedAt string `json:"trusted_at"`
+	Expires   string `json:"expires,omitempty"`
+}
+
+func (t *trustFile) trusted(subject string) bool {
+	if t == nil || t.path == "" || subject == "" {
+		return false
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	fi, err := os.Stat(t.path)
+	if err != nil {
+		t.m = nil
+		t.mod = time.Time{}
+		return false
+	}
+	if t.m == nil || !fi.ModTime().Equal(t.mod) || fi.Size() != t.size {
+		t.m = map[string]time.Time{}
+		t.mod, t.size = fi.ModTime(), fi.Size()
+		b, err := os.ReadFile(t.path)
+		if err != nil {
+			return false
+		}
+		var raw map[string]trustEntry
+		if json.Unmarshal(b, &raw) != nil {
+			return false
+		}
+		for k, v := range raw {
+			var exp time.Time
+			if v.Expires != "" {
+				if exp, err = time.Parse(time.RFC3339, v.Expires); err != nil {
+					continue // bad expiry: ignore the entry
+				}
+			}
+			t.m[k] = exp
+		}
+	}
+	exp, ok := t.m[subject]
+	return ok && (exp.IsZero() || time.Now().Before(exp))
+}
+
+// NewSessionGate builds the session gate from policy.
+func NewSessionGate(pol config.Policy) *SessionGate {
+	ttl := pol.SessionTTL
+	if ttl <= 0 {
+		ttl = time.Hour
+	}
+	return &SessionGate{enabled: pol.SessionApproval, ttl: ttl, trust: &trustFile{path: pol.SessionTrustFile}}
+}
+
+// Name implements inspect.Check.
+func (g *SessionGate) Name() string { return NameSessionGate }
+
+// Inspect implements inspect.Check.
+func (g *SessionGate) Inspect(_ context.Context, s inspect.Session, m *inspect.Msg) inspect.Decision {
+	if !g.enabled || m == nil || m.Env == nil || m.Dir != inspect.C2S {
+		return inspect.AllowAll
+	}
+	if g.trust.trusted(s.Identity().Subject) {
+		return inspect.AllowAll
+	}
+	st := GateOf(s)
+	switch {
+	case m.Env.Method == mcp.MethodInitialize:
+		var p struct {
+			ClientInfo struct {
+				Name string `json:"name"`
+			} `json:"clientInfo"`
+		}
+		_ = json.Unmarshal(m.Env.Params, &p)
+		st.mu.Lock()
+		st.client = sanitizeClient(p.ClientInfo.Name)
+		st.mu.Unlock()
+		return inspect.AllowAll
+	case m.Env.Method == mcp.MethodPing, m.Env.IsNotification():
+		return inspect.AllowAll
+	}
+	st.mu.Lock()
+	st.ttl = g.ttl
+	client := st.client
+	st.mu.Unlock()
+	if st.Approved() {
+		return inspect.AllowAll
+	}
+	if st.Denied() {
+		return inspect.Denyf(m.Env, jsonrpc.CodePolicyDenied, NameSessionGate,
+			"session access was denied; ask the owner to approve")
+	}
+	return inspect.Decision{
+		Verdict: inspect.Hold,
+		Rule:    NameSessionGate + "|" + client,
+		Reason:  "session requires approval",
+	}
+}
+
+// IsSessionGateRule reports whether a decision rule came from the gate.
+func IsSessionGateRule(rule string) bool { return strings.HasPrefix(rule, NameSessionGate) }
+
+func sanitizeClient(n string) string {
+	n = strings.Map(func(r rune) rune {
+		if r < 0x20 || r == '|' {
+			return -1
+		}
+		return r
+	}, n)
+	if len(n) > 60 {
+		n = n[:60]
+	}
+	return n
+}
