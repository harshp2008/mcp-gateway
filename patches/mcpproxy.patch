+// StaticNamed accepts the optional shared token plus named per-client tokens
+// (local patch). A named token yields Subject "client:<name>". Every
+// candidate is compared in constant time with no early exit.
+func StaticNamed(shared string, named map[string]string) (Resolver, error) {
+	type entry struct {
+		want []byte
+		id   inspect.Identity
+	}
+	var all []entry
+	if shared != "" {
+		all = append(all, entry{[]byte(shared), inspect.Identity{Subject: StaticSubject}})
+	}
+	for name, tok := range named {
+		if tok == "" {
+			return nil, fmt.Errorf("inbound static: token for client %q is empty", name)
+		}
+		all = append(all, entry{[]byte(tok), inspect.Identity{Subject: "client:" + name}})
+	}
+	return func(r *http.Request) (inspect.Identity, error) {
+		got, err := bearerToken(r)
+		if err != nil {
+			return inspect.Identity{}, err
+		}
+		var found inspect.Identity
+		ok := 0
+		for _, e := range all {
+			if subtle.ConstantTimeCompare([]byte(got), e.want) == 1 {
+				found, ok = e.id, 1
+			}
+		}
+		if ok != 1 {
+			return inspect.Identity{}, fmt.Errorf("%w: invalid static token", ErrUnauthenticated)
+		}
+		return found, nil
+	}, nil
+}
