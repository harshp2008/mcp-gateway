diff --git a/checks/cmdguard.go b/checks/cmdguard.go
new file mode 100644
index 0000000..29d892a
--- /dev/null
+++ b/checks/cmdguard.go
@@ -0,0 +1,115 @@
+package checks
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"strings"
+	"time"
+
+	"github.com/hoophq/mcpproxy/config"
+	"github.com/hoophq/mcpproxy/inspect"
+	"github.com/hoophq/mcpproxy/jsonrpc"
+)
+
+// NameCmdGuard is the audit rule for denials from the command guard.
+const NameCmdGuard = "command-guard"
+
+// CmdGuard (local patch) asks an external destructive-command guard (dcg) about
+// the shell command in matching tool calls. It fails CLOSED: if the guard
+// cannot be run or answers garbage, the call is denied.
+type CmdGuard struct {
+	bin   string
+	tools []string
+}
+
+// NewCmdGuard builds the check; with no binary or tools it allows everything.
+func NewCmdGuard(pol config.Policy) *CmdGuard {
+	return &CmdGuard{bin: pol.CommandGuardBin, tools: pol.CommandGuardTools}
+}
+
+// Name implements inspect.Check.
+func (c *CmdGuard) Name() string { return NameCmdGuard }
+
+// Inspect implements inspect.Check.
+func (c *CmdGuard) Inspect(ctx context.Context, s inspect.Session, m *inspect.Msg) inspect.Decision {
+	exposed, ok := isToolCall(m)
+	if !ok || c.bin == "" || len(c.tools) == 0 {
+		return inspect.AllowAll
+	}
+	tool := RealToolName(s, exposed)
+	if !matchApproval(c.tools, m.Backend, tool) {
+		return inspect.AllowAll
+	}
+	var p struct {
+		Arguments map[string]any `json:"arguments"`
+	}
+	if err := json.Unmarshal(m.Env.Params, &p); err != nil {
+		return c.deny(m, "cannot parse tool arguments")
+	}
+	for _, key := range []string{"command", "input"} {
+		v, ok := p.Arguments[key].(string)
+		if !ok || strings.TrimSpace(v) == "" {
+			continue
+		}
+		if reason := c.check(ctx, v); reason != "" {
+			return c.deny(m, reason)
+		}
+	}
+	return inspect.AllowAll
+}
+
+func (c *CmdGuard) deny(m *inspect.Msg, reason string) inspect.Decision {
+	return inspect.Denyf(m.Env, jsonrpc.CodePolicyDenied, NameCmdGuard,
+		fmt.Sprintf("blocked by command guard: %s", reason))
+}
+
+// check returns "" when the command is allowed, else a short reason.
+func (c *CmdGuard) check(ctx context.Context, command string) string {
+	in, _ := json.Marshal(map[string]any{
+		"tool_name":  "Bash",
+		"tool_input": map[string]string{"command": command},
+	})
+	cctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(cctx, c.bin)
+	cmd.Stdin = bytes.NewReader(in)
+	// Keep dcg from "repairing" hooks in the real Claude Code settings.
+	cmd.Env = append(os.Environ(), "CLAUDE_CONFIG_DIR=/tmp/dcg-null-config", "DCG_QUIET=1", "DCG_NO_COLOR=1")
+	var out bytes.Buffer
+	cmd.Stdout = &out
+	if err := cmd.Run(); err != nil {
+		return "guard failed to run: " + err.Error()
+	}
+	for _, line := range strings.Split(out.String(), "\n") {
+		line = strings.TrimSpace(line)
+		if !strings.HasPrefix(line, "{") {
+			continue
+		}
+		var r struct {
+			Hook struct {
+				Decision string `json:"permissionDecision"`
+				Reason   string `json:"permissionDecisionReason"`
+			} `json:"hookSpecificOutput"`
+			RuleID string `json:"ruleId"`
+		}
+		if json.Unmarshal([]byte(line), &r) != nil {
+			continue
+		}
+		if r.Hook.Decision == "deny" {
+			reason := r.RuleID
+			if i := strings.Index(r.Hook.Reason, "Reason: "); i >= 0 {
+				rest := r.Hook.Reason[i+8:]
+				if j := strings.Index(rest, "\n"); j >= 0 {
+					rest = rest[:j]
+				}
+				reason = r.RuleID + " - " + rest
+			}
+			return reason
+		}
+	}
+	return ""
+}
