new file mode 100644
index 0000000..9fb27ec
--- /dev/null
+++ b/cmd/mcpproxyd/consent.go
@@ -0,0 +1,63 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"sync"
+	"time"
+
+	"github.com/hoophq/mcpproxy/approval"
+	"github.com/hoophq/mcpproxy/auth/authserver"
+	"github.com/hoophq/mcpproxy/gateway"
+)
+
+// newConsent turns OAuth /authorize into a held call that the PC popup answers.
+// Unauthenticated callers can reach /authorize, so it is rate limited: one
+// pending consent at a time, a cooldown after a denial, and an hourly cap.
+func newConsent(held *approval.Store) authserver.ConsentFunc {
+	var mu sync.Mutex
+	pending := false
+	var stamps []time.Time
+	denied := map[string]time.Time{}
+	return func(ctx context.Context, req authserver.ConsentRequest) (bool, error) {
+		mu.Lock()
+		now := time.Now()
+		if t, ok := denied[req.ClientID]; ok && now.Sub(t) < time.Minute {
+			mu.Unlock()
+			return false, errors.New("cooldown after denial")
+		}
+		keep := stamps[:0]
+		for _, t := range stamps {
+			if now.Sub(t) < time.Hour {
+				keep = append(keep, t)
+			}
+		}
+		stamps = keep
+		if pending || len(stamps) >= 10 {
+			mu.Unlock()
+			return false, errors.New("too many consent requests")
+		}
+		pending = true
+		stamps = append(stamps, now)
+		mu.Unlock()
+		defer func() { mu.Lock(); pending = false; mu.Unlock() }()
+
+		args, _ := json.Marshal(map[string]string{
+			"client_id": req.ClientID, "client_name": req.ClientName, "redirect_host": req.RedirectHost})
+		_, ch, err := held.Hold(ctx, gateway.HeldCall{
+			Session: "oauth", User: "oauth:" + req.ClientID, Backend: "gateway",
+			Tool: "oauth-consent", Args: args, Rule: "oauth-consent",
+		})
+		if err != nil {
+			return false, err
+		}
+		ok := <-ch
+		if !ok {
+			mu.Lock()
+			denied[req.ClientID] = time.Now()
+			mu.Unlock()
+		}
+		return ok, nil
+	}
+}
diff --git a/cmd/mcpproxyd/icon.go b/cmd/mcpproxyd/icon.go
new file mode 100644
index 0000000..c3e3dc4
--- /dev/null
+++ b/cmd/mcpproxyd/icon.go
@@ -0,0 +1,101 @@
+package main
+
+import (
+	"bytes"
+	"hash/fnv"
+	"image"
+	"image/color"
+	"image/png"
+	"math"
+	"net/http"
+	"os"
+	"sync"
+)
+
+// Local patch: a tiny laptop icon whose colour is derived from MCP_SERVER_NAME,
+// so each PC's connector looks different in apps that show an icon (e.g. Gemini).
+// Served unauthenticated at /icon.png and /favicon.ico (icons are not sensitive).
+
+var (
+	iconOnce sync.Once
+	iconData []byte
+)
+
+func hsvToRGB(h, s, v float64) color.RGBA {
+	c := v * s
+	x := c * (1 - math.Abs(math.Mod(h/60, 2)-1))
+	m := v - c
+	var r, g, b float64
+	switch {
+	case h < 60:
+		r, g, b = c, x, 0
+	case h < 120:
+		r, g, b = x, c, 0
+	case h < 180:
+		r, g, b = 0, c, x
+	case h < 240:
+		r, g, b = 0, x, c
+	case h < 300:
+		r, g, b = x, 0, c
+	default:
+		r, g, b = c, 0, x
+	}
+	return color.RGBA{uint8((r + m) * 255), uint8((g + m) * 255), uint8((b + m) * 255), 255}
+}
+
+func buildIcon() []byte {
+	name := os.Getenv("MCP_SERVER_NAME")
+	if name == "" {
+		name = "mcp"
+	}
+	hh := fnv.New32a()
+	_, _ = hh.Write([]byte(name))
+	bg := hsvToRGB(float64(hh.Sum32()%360), 0.65, 0.85)
+	white := color.RGBA{255, 255, 255, 255}
+	const n = 128
+	img := image.NewRGBA(image.Rect(0, 0, n, n))
+	rect := func(x0, y0, x1, y1 int, c color.RGBA) {
+		for y := y0; y < y1; y++ {
+			for x := x0; x < x1; x++ {
+				img.SetRGBA(x, y, c)
+			}
+		}
+	}
+	// rounded-square background (radius 24)
+	const rad = 24.0
+	for y := 0; y < n; y++ {
+		for x := 0; x < n; x++ {
+			dx, dy := 0.0, 0.0
+			if float64(x) < rad {
+				dx = rad - float64(x)
+			} else if float64(x) > n-1-rad {
+				dx = float64(x) - (n - 1 - rad)
+			}
+			if float64(y) < rad {
+				dy = rad - float64(y)
+			} else if float64(y) > n-1-rad {
+				dy = float64(y) - (n - 1 - rad)
+			}
+			if dx*dx+dy*dy <= rad*rad {
+				img.SetRGBA(x, y, bg)
+			}
+		}
+	}
+	rect(30, 32, 98, 82, white) // lid
+	rect(36, 38, 92, 76, bg)    // screen
+	rect(18, 88, 110, 98, white) // base
+	var buf bytes.Buffer
+	_ = png.Encode(&buf, img)
+	return buf.Bytes()
+}
+
+func registerIcon(mux *http.ServeMux) {
+	h := func(w http.ResponseWriter, _ *http.Request) {
+		iconOnce.Do(func() { iconData = buildIcon() })
+		w.Header().Set("Content-Type", "image/png")
+		w.Header().Set("Cache-Control", "public, max-age=3600")
+		_, _ = w.Write(iconData)
+	}
+	mux.HandleFunc("/icon.png", h)
+	mux.HandleFunc("/favicon.ico", h)
+}
