#!/usr/bin/env python3
"""mcp-gateway: manage a shared, OAuth-protected MCP gateway on this PC.

  mcp-gateway name [NAME]          show / set this PC's name (default: hostname)
  mcp-gateway url [URL]            show / set the public https URL (for web apps like Gemini)
  mcp-gateway backend list|add|remove ...
  mcp-gateway client add NAME      per-client static token (Claude Code, scripts)
  mcp-gateway trust list|revoke SUBJECT|add SUBJECT [DAYS]
  mcp-gateway desktop [--yes] [--keep-duplicates]  wire Claude Desktop to the gateway (asks before closing it)
  mcp-gateway uninstall [--dry-run] [--yes] [--keep-data] [--keep-desktop]   remove everything this installer set up
  mcp-gateway funnel               expose this PC via Tailscale Funnel + set the public URL
  mcp-gateway connect [claude-desktop|claude-code|gemini|other]
  mcp-gateway extension [--only NAME..]  Gemini auto-allow Chrome extension (all mcp-* connectors) + install steps
  mcp-gateway status | restart | logs | render
"""
import json, os, re, secrets, socket, subprocess, sys, shutil, datetime, time

HOME = os.environ.get("MCPGW_HOME") or os.path.expanduser("~/.mcp-gateway")
SETTINGS = f"{HOME}/settings.json"
ENVF = f"{HOME}/gateway.env"
CFG = f"{HOME}/config.yaml"
TRUST = f"{HOME}/trusted.json"
PORT = 8765
KNOWN_BACKENDS = {  # name -> (description, command-builder)
    "terminal": ("open-terminal (shell + files)", lambda: [shutil.which("open-terminal") or "open-terminal", "mcp", "--cwd", os.path.expanduser("~")]),
    "figcraft": ("FigCraft (Figma-style design tool)", lambda: [shutil.which("figcraft-cli") or "figcraft-cli", "mcp"]),
}


def die(m):
    sys.exit("error: " + m)


def slug(s):
    s = re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")
    return s[:30] or "pc"


def load():
    try:
        return json.load(open(SETTINGS))
    except FileNotFoundError:
        return {"name": "", "public_url": "", "backends": {}, "clients": []}


def save(s):
    os.makedirs(HOME, exist_ok=True)
    json.dump(s, open(SETTINGS, "w"), indent=2)
    os.chmod(SETTINGS, 0o600)


def machine_name(s):
    return slug(s.get("name") or socket.gethostname())


def read_env():
    d = {}
    try:
        for line in open(ENVF):
            if "=" in line and not line.startswith("#"):
                k, v = line.rstrip("\n").split("=", 1)
                d[k] = v.strip('"')
    except FileNotFoundError:
        pass
    return d


def write_env(d):
    tmp = ENVF + ".tmp"
    with open(tmp, "w") as f:
        for k, v in d.items():
            f.write(f'{k}="{v}"\n' if re.search(r"[ ()]", v) else f"{k}={v}\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, ENVF)


def ensure_secrets(env):
    for k in ("MCPPROXY_TOKEN", "MCPPROXY_APPROVAL_TOKEN", "OPEN_TERMINAL_API_KEY"):
        env.setdefault(k, secrets.token_urlsafe(32))


def render():
    """settings.json -> gateway.env + config.yaml"""
    s = load()
    env = read_env()
    ensure_secrets(env)
    name = machine_name(s)
    env["MCP_SERVER_NAME"] = f"mcp-{name}"
    env["MCP_LABEL"] = f"{name.upper()} (hostname {socket.gethostname()})"
    if s.get("public_url"):
        env["MCP_PUBLIC_URL"] = s["public_url"]
    for c in s["clients"]:
        env.setdefault("CLIENT_TOKEN_" + c.upper().replace("-", "_"), secrets.token_urlsafe(32))
    y = [f"# generated by `mcp-gateway render` - edit with the CLI, not by hand",
         f"listen: 127.0.0.1:{PORT}", "", "inbound:", "  mode: static", "  token: ${MCPPROXY_TOKEN}"]
    if s["clients"]:
        y.append("  tokens:")
        y += [f"    {c}: ${{CLIENT_TOKEN_{c.upper().replace('-', '_')}}}" for c in s["clients"]]
    y += ["", "backends:"]
    for b, spec in s["backends"].items():
        y += [f"  {b}:", "    transport: stdio", "    command: " + json.dumps(spec["command"])]
        envs = dict(spec.get("env", {}))
        if b == "terminal":
            envs.setdefault("OPEN_TERMINAL_API_KEY", "${OPEN_TERMINAL_API_KEY}")
        if envs:
            y.append("    env:")
            for k, v in envs.items():
                if not v.startswith("${"):
                    var = re.sub(r"[^A-Z0-9]", "_", f"BACKEND_{b}_{k}".upper())
                    env[var] = v
                    v = "${" + var + "}"
                y.append(f"      {k}: {v}")
    y += ["", "policy:"]
    if "terminal" in s["backends"]:
        y += [f"  command_guard_bin: {HOME}/bin/dcg", "  command_guard_tools:",
              "    - terminal/run_command", "    - terminal/send_process_input", "    - terminal/send_user_terminal_input"]
    y += ["  session_approval: true", "  session_ttl: 1h", f"  session_trust_file: {TRUST}", "  approval_tools:", "",
          "approvals:", "  timeout: 5m", "  api_token: ${MCPPROXY_APPROVAL_TOKEN}", "", f"wal_dir: {HOME}/sessions"]
    if s.get("public_url"):
        y += ["", "auth_server:", f"  issuer: {s['public_url']}", f"  signing_key_file: {HOME}/oauth-signing-key.pem",
              f"  clients_file: {HOME}/oauth-clients.json", "  access_token_ttl: 12h"]
    write_env(env)
    open(CFG, "w").write("\n".join(y) + "\n")
    os.chmod(CFG, 0o600)
    return s


def sctl(*a):
    env = dict(os.environ, XDG_RUNTIME_DIR=f"/run/user/{os.getuid()}")
    return subprocess.run(["systemctl", "--user", *a], env=env, capture_output=True, text=True)


def restart():
    unit = os.path.expanduser("~/.config/systemd/user/mcp-gateway.service")
    try:
        mine = HOME in open(unit).read()
    except FileNotFoundError:
        mine = False
    if not mine:
        print("(no service installed for this home; not restarting)")
        return
    r = sctl("restart", "mcp-gateway.service")
    print("gateway restarted" if r.returncode == 0 else "restart failed: " + r.stderr.strip())


def cmd_name(a):
    s = load()
    if a:
        s["name"] = slug(" ".join(a))
        save(s); render(); restart()
    print(f"this PC: {machine_name(s)}  (connector/server name: mcp-{machine_name(s)})"
          + ("" if s.get("name") else "   [default = hostname]"))
    if a:
        print("Web apps cache the old name: remove + re-add the connector (e.g. in Gemini) to see it.")


def cmd_url(a):
    s = load()
    if a:
        s["public_url"] = a[0].rstrip("/")
        save(s); render(); restart()
    print(s.get("public_url") or "(none - local only; run: mcp-gateway url https://<host>.<tailnet>.ts.net:10000)")


def cmd_backend(a):
    s = load()
    sub = a[0] if a else "list"
    if sub == "list":
        for b, spec in s["backends"].items():
            print(f"{b}: {' '.join(spec['command'])}")
        print("known presets:", ", ".join(KNOWN_BACKENDS))
    elif sub == "add":
        if len(a) < 2:
            die("backend add NAME [-- command args...]   (presets: " + ", ".join(KNOWN_BACKENDS) + ")")
        n = slug(a[1])
        if "--" in a:
            cmd = a[a.index("--") + 1:]
        elif n in KNOWN_BACKENDS:
            cmd = KNOWN_BACKENDS[n][1]()
        else:
            die("unknown preset; give a command: mcp-gateway backend add NAME -- cmd args")
        s["backends"][n] = {"command": cmd}
        save(s); render(); restart()
        print(f"backend '{n}' added: {' '.join(cmd)}")
    elif sub == "remove":
        s["backends"].pop(a[1], None); save(s); render(); restart()


def cmd_client(a):
    if len(a) < 2 or a[0] != "add":
        die("client add NAME")
    n = a[1]
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,30}", n):
        die("name: lowercase letters, digits, dashes")
    s = load()
    if n in s["clients"]:
        die("client exists")
    s["clients"].append(n); save(s); render(); restart()
    tok = read_env()["CLIENT_TOKEN_" + n.upper().replace("-", "_")]
    print(f"client '{n}' (subject client:{n}). Authorization: Bearer {tok}")


def cmd_trust(a):
    sub = a[0] if a else "list"
    try:
        d = json.load(open(TRUST))
    except FileNotFoundError:
        d = {}
    if sub == "list":
        for k, v in d.items():
            print(k, "trusted", v.get("trusted_at"), "expires", v.get("expires") or "never")
        if not d:
            print("(nobody trusted)")
        return
    if sub == "revoke":
        d.pop(a[1], None)
    elif sub == "add":
        now = datetime.datetime.now(datetime.timezone.utc)
        e = {"trusted_at": now.isoformat(timespec="seconds")}
        if len(a) > 2:
            e["expires"] = (now + datetime.timedelta(days=float(a[2]))).isoformat(timespec="seconds")
        d[a[1]] = e
    tmp = TRUST + ".tmp"
    open(tmp, "w").write(json.dumps(d, indent=2)); os.chmod(tmp, 0o600); os.replace(tmp, TRUST)
    print("ok")


def make_ext(args=(), quiet=False):
    src = f"{HOME}/app/extension"
    dst = f"{HOME}/extension"
    if not os.path.isdir(src):
        die("extension files missing; re-run install.sh")
    only = []
    args = list(args)
    if args and args[0] == "--only":
        only = args[1:]
        if not only:
            die("extension --only NAME [NAME...]   e.g. --only mcp-main-laptop")
    prefixes = [re.sub(r"[-_\s]+", " ", n.lower()).strip() + ("" if only else " ") for n in only] or ["mcp "]
    os.makedirs(dst, exist_ok=True)
    shutil.copy(f"{src}/manifest.json", f"{dst}/manifest.json")
    js = open(f"{src}/content.js").read()
    js = re.sub(r'const ALLOW = \[.*?\];', "const ALLOW = " + json.dumps(prefixes) + ";", js, count=1)
    open(f"{dst}/content.js", "w").write(js)
    if quiet:
        return
    what = ("only: " + ", ".join(only)) if only else "every connector named mcp-* (all your PCs)"
    print(f"""Chrome extension written to: {dst}
Auto-clicks Gemini's "Allow once" card for {what}.

Install (Chrome / Chromium / Edge / Brave) - once per browser, covers ALL your gateway PCs:
  1. open chrome://extensions
  2. turn on "Developer mode" (top right)
  3. click "Load unpacked" and pick: {dst}
  4. reload gemini.google.com
  Test: ask Gemini to use @mcp-{machine_name(load())}; the card should click itself
  (DevTools console shows "[gw-autoallow] active").
It is the same extension for every PC. On a laptop without a gateway just clone the repo and load its extension/ folder.
Safety: dangerous shell commands are still blocked by dcg on each gateway; remove the extension to get the cards back.""")


# ---------------------------------------------------------------- Claude Desktop
DESKTOP_CFG = os.path.expanduser("~/.config/Claude/claude_desktop_config.json")


def ask(q, default=False, yes=False):
    if yes:
        return True
    try:
        tty = open("/dev/tty")
    except OSError:
        return default
    sys.stdout.write(f"{q} [{'Y/n' if default else 'y/N'}] "); sys.stdout.flush()
    a = tty.readline().strip().lower()
    return default if not a else a.startswith("y")


def desktop_pids():
    out = subprocess.run(["ps", "-eo", "pid,comm", "--no-headers"], capture_output=True, text=True).stdout
    return [int(l.split()[0]) for l in out.splitlines() if l.split()[1:] == ["claude-desktop"]]


def preset_of(spec):
    """Which built-in backend preset (terminal/figcraft) does this Desktop entry duplicate?"""
    base = os.path.basename((spec.get("command") or "")) + " " + " ".join(spec.get("args") or [])
    if "open-terminal" in base:
        return "terminal"
    if "figcraft" in base:
        return "figcraft"
    return None


def is_gateway_entry(name, spec):
    blob = json.dumps(spec)
    return name.startswith("mcp-") or "127.0.0.1:%d" % PORT in blob or ".ts.net" in blob and "mcp-remote" in blob


def cmd_desktop(args):
    yes = "--yes" in args
    keep = "--keep-duplicates" in args
    if not os.path.exists(DESKTOP_CFG) and not shutil.which("claude-desktop"):
        print("Claude Desktop not found - skipping (https://claude.ai/download)."); return
    if not os.path.exists(DESKTOP_CFG):
        os.makedirs(os.path.dirname(DESKTOP_CFG), exist_ok=True)
        open(DESKTOP_CFG, "w").write("{}")
    try:
        cfg = json.load(open(DESKTOP_CFG))
    except ValueError:
        die(f"{DESKTOP_CFG} is not valid JSON; fix it first")
    s = load(); n = machine_name(s); key = f"mcp-{n}"
    servers = cfg.setdefault("mcpServers", {})

    # token for Desktop (created once)
    cvar = "CLIENT_TOKEN_CLAUDE_DESKTOP"
    if "claude-desktop" not in s["clients"]:
        s["clients"].append("claude-desktop"); save(s); render()
    tok = read_env()[cvar]

    # other servers already configured in Desktop -> import into the gateway
    importable, dupes, skipped = {}, [], []
    for name, spec in list(servers.items()):
        if name == key or is_gateway_entry(name, spec):
            continue
        if "command" not in spec:
            skipped.append(name); continue
        pre = preset_of(spec)
        if pre:
            dupes.append(name)               # covered by a built-in preset
            if pre not in s["backends"] and pre in KNOWN_BACKENDS:
                importable[pre] = {"command": KNOWN_BACKENDS[pre][1]()}
        else:
            importable[slug(name)] = {"command": [spec["command"]] + list(spec.get("args") or []),
                                      **({"env": spec["env"]} if spec.get("env") else {})}
            dupes.append(name)
    print(f"\nClaude Desktop config: {DESKTOP_CFG}")
    print(f"  will add:    {key}  (-> this gateway)")
    if importable: print("  will import into the gateway:", ", ".join(importable))
    if skipped: print("  can't import (not a local command server, left untouched):", ", ".join(skipped))
    remove = False
    if dupes and not keep:
        print("  these are now ALSO reachable through the gateway (duplicates):", ", ".join(dupes))
        remove = ask("Move the duplicates out of Claude Desktop (reversible, kept under _disabledMcpServers)?", True, yes)

    pids = desktop_pids()
    if pids:
        print("\nClaude Desktop is running and must be closed to change its config.")
        print("Check it first: no chat/task running, nothing unsaved (it will be reopened afterwards).")
        if not ask("Close Claude Desktop now?", False, yes):
            print("Not touching Desktop. Re-run `mcp-gateway desktop` when ready."); return
        for pid in pids:
            try: os.kill(pid, 15)
            except ProcessLookupError: pass
        for _ in range(30):
            if not desktop_pids(): break
            time.sleep(0.5)
        if desktop_pids():
            if ask("Still running. Force-quit it?", False, yes):
                for pid in desktop_pids():
                    try: os.kill(pid, 9)
                    except ProcessLookupError: pass
                time.sleep(1)
            else:
                print("Aborted, nothing changed."); return
        # Desktop may rewrite config on exit: re-read
        try: cfg = json.load(open(DESKTOP_CFG)); servers = cfg.setdefault("mcpServers", {})
        except ValueError: pass

    # apply
    for b, spec in importable.items():
        s["backends"][b] = spec
    save(s); render(); restart()
    shutil.copy(DESKTOP_CFG, DESKTOP_CFG + ".bak." + datetime.datetime.now().strftime("%Y%m%d%H%M%S"))
    servers[key] = {"command": "npx", "args": ["-y", "mcp-remote", f"http://127.0.0.1:{PORT}/mcp",
                    "--header", "Authorization: Bearer ${GW_AUTH}"], "env": {"GW_AUTH": tok}}
    if remove:
        dis = cfg.setdefault("_disabledMcpServers", {})
        for name in dupes:
            if name in servers: dis[name] = servers.pop(name)
    tmp = DESKTOP_CFG + ".tmp"
    open(tmp, "w").write(json.dumps(cfg, indent=2)); os.chmod(tmp, 0o600); os.replace(tmp, DESKTOP_CFG)
    print(f"Claude Desktop configured: {key}" + (f"; moved out: {', '.join(dupes)}" if remove else ""))
    if pids or ask("Open Claude Desktop now?", True, yes):
        exe = shutil.which("claude-desktop")
        if exe:
            subprocess.Popen([exe], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            print("Claude Desktop relaunched. First use pops an approval on this PC -> 'Trust this client'.")
        else:
            print("Start Claude Desktop yourself (launcher not found).")


# ---------------------------------------------------------------- Tailscale Funnel
FUNNEL_PORT = 10000
FUNNEL_PATHS = ["/mcp", "/token", "/register", "/authorize", "/.well-known", "/icon.png", "/favicon.ico"]


def cmd_funnel(args):
    if not shutil.which("tailscale"):
        die("Tailscale isn't installed. Install:  curl -fsSL https://tailscale.com/install.sh | sh   then: sudo tailscale up")
    r = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True)
    try:
        st = json.loads(r.stdout)
    except ValueError:
        die("can't read tailscale status. Is the daemon running?  sudo systemctl start tailscaled")
    if st.get("BackendState") != "Running":
        die(f"Tailscale is {st.get('BackendState')}. Log in with:  sudo tailscale up   (then re-run this)")
    dns = (st["Self"].get("DNSName") or "").rstrip(".")
    if not dns:
        die("no MagicDNS name. Enable MagicDNS + HTTPS Certificates at https://login.tailscale.com/admin/dns")
    for pth in FUNNEL_PATHS:
        r = subprocess.run(["tailscale", "funnel", "--bg", f"--https={FUNNEL_PORT}", f"--set-path={pth}",
                            f"http://127.0.0.1:{PORT}{pth}"], capture_output=True, text=True, timeout=60)
        if r.returncode != 0:
            msg = (r.stdout + r.stderr).strip()
            print(f"funnel {pth} failed:\n{msg}\n")
            if "operator" in msg.lower() or "access denied" in msg.lower():
                print(f"Fix: sudo tailscale set --operator=$USER   (then re-run)")
            elif "funnel" in msg.lower():
                print("Funnel isn't allowed for this machine yet. Open the link above (or "
                      "https://login.tailscale.com/admin/acls), enable Funnel/HTTPS, then re-run.")
            sys.exit(1)
    url = f"https://{dns}:{FUNNEL_PORT}"
    s = load(); s["public_url"] = url; save(s); render(); restart()
    print(f"\nPublic URL for this PC: {url}\nGemini connector URL:   {url}/mcp\n"
          f"Only these paths are exposed: {' '.join(FUNNEL_PATHS)}")


# ---------------------------------------------------------------- uninstall
def cmd_uninstall(args):
    yes, dry = "--yes" in args, "--dry-run" in args
    keep_data, keep_desktop = "--keep-data" in args, "--keep-desktop" in args
    s = load()
    n = machine_name(s); key = f"mcp-{n}"
    unit_dir = os.path.expanduser("~/.config/systemd/user")
    units = [f"{unit_dir}/mcp-gateway.service", f"{unit_dir}/mcp-gateway-approver.service"]
    try:
        mine = HOME in open(units[0]).read()      # the installed service belongs to THIS home
    except FileNotFoundError:
        mine = False
    link = os.path.expanduser("~/.local/bin/mcp-gateway")
    safe_home = (os.path.isfile(SETTINGS) or os.path.isfile(ENVF)) and os.path.realpath(HOME) not in ("/", os.path.expanduser("~"))
    plan = []
    if mine: plan.append("stop + disable the mcp-gateway and approval-popup services, delete their unit files")
    if mine and s.get("public_url") and shutil.which("tailscale"):
        plan.append("turn OFF only this gateway's Tailscale Funnel paths on port %d (other Tailscale settings untouched)" % FUNNEL_PORT)
    desk = False
    if not keep_desktop and os.path.exists(DESKTOP_CFG):
        try:
            c = json.load(open(DESKTOP_CFG))
            desk = key in c.get("mcpServers", {})
        except ValueError:
            pass
        if desk:
            plan.append(f"remove '{key}' from Claude Desktop and put back any servers moved to _disabledMcpServers (closes + reopens Desktop)")
    if os.path.islink(link): plan.append(f"remove {link}")
    if not keep_data and safe_home: plan.append(f"DELETE {HOME} (config, tokens, trust list, OAuth signing key, logs, the extension folder)")
    if keep_data: plan.append(f"keep {HOME} (--keep-data)")
    if not plan:
        print("nothing to remove for this install."); return
    print("This will:"); [print("  -", x) for x in plan]
    print("Not touched: Tailscale, open-terminal, Go, dcg's own hook in Claude Code settings, the cloned repo, your Gemini connector.")
    if dry: print("\n(dry run - nothing changed)"); return
    if not ask("Continue?", False, yes): print("Aborted."); return

    # 1) Funnel: only our paths
    if mine and s.get("public_url") and shutil.which("tailscale"):
        for pth in FUNNEL_PATHS:
            subprocess.run(["tailscale", "funnel", f"--https={FUNNEL_PORT}", f"--set-path={pth}", "off"],
                           capture_output=True, text=True, timeout=60)
        print("funnel paths turned off")
    # 2) Claude Desktop
    if desk:
        pids = desktop_pids()
        proceed = True
        if pids:
            print("Claude Desktop is running and must be closed (check no chat/task is running).")
            proceed = ask("Close Claude Desktop now?", False, yes)
            if proceed:
                for pid in pids:
                    try: os.kill(pid, 15)
                    except ProcessLookupError: pass
                for _ in range(30):
                    if not desktop_pids(): break
                    time.sleep(0.5)
                if desktop_pids():
                    if ask("Still running. Force-quit it?", False, yes):
                        for pid in desktop_pids():
                            try: os.kill(pid, 9)
                            except ProcessLookupError: pass
                        time.sleep(1)
                    else:
                        proceed = False
        if proceed:
            c = json.load(open(DESKTOP_CFG))
            srv = c.setdefault("mcpServers", {})
            srv.pop(key, None)
            dis = c.get("_disabledMcpServers", {})
            for name in list(dis):
                if name not in srv:
                    srv[name] = dis.pop(name)      # restore what we moved aside
            if not dis: c.pop("_disabledMcpServers", None)
            shutil.copy(DESKTOP_CFG, DESKTOP_CFG + ".bak." + datetime.datetime.now().strftime("%Y%m%d%H%M%S"))
            tmp = DESKTOP_CFG + ".tmp"
            open(tmp, "w").write(json.dumps(c, indent=2)); os.chmod(tmp, 0o600); os.replace(tmp, DESKTOP_CFG)
            print(f"Claude Desktop: removed {key}, restored servers that were moved aside")
            if pids and shutil.which("claude-desktop"):
                subprocess.Popen([shutil.which("claude-desktop")], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
                print("Claude Desktop reopened")
        else:
            print("Skipped Claude Desktop (still has the gateway entry; re-run: mcp-gateway uninstall)")
    # 3) services
    if mine:
        for u in ("mcp-gateway-approver", "mcp-gateway"):
            sctl("disable", "--now", u + ".service")
        for f in units:
            try: os.remove(f)
            except FileNotFoundError: pass
        sctl("daemon-reload")
        print("services removed")
    # 4) symlink + data (last: this script lives in HOME, fine on Linux)
    if os.path.islink(link):
        os.remove(link)
    if not keep_data and safe_home:
        shutil.rmtree(HOME)
        print(f"deleted {HOME}")
    print("\nDone. Remember to: delete the connector in Gemini, and remove the Chrome extension at chrome://extensions if you loaded it.")


def cmd_status(_):
    s = load()
    print(f"name: mcp-{machine_name(s)}   url: {s.get('public_url') or '(local only)'}")
    for u in ("mcp-gateway", "mcp-gateway-approver"):
        print(f"{u}: {sctl('is-active', u + '.service').stdout.strip()}")
    print("backends:", ", ".join(s["backends"]) or "(none)")
    print("clients:", ", ".join(s["clients"]) or "(none - OAuth/mcp-remote only)")
    cmd_trust(["list"])


def cmd_connect(a):
    s = load()
    env = read_env()
    n = machine_name(s)
    url = s.get("public_url")
    app = a[0] if a else "all"
    if app in ("all", "claude-desktop"):
        print(f"""== Claude Desktop (stdio bridge, then approve the popup on this PC) ==
Add to ~/.config/Claude/claude_desktop_config.json under "mcpServers" (Windows/macOS: Claude's config folder):
  "mcp-{n}": {{ "command": "npx", "args": ["-y", "mcp-remote", "http://127.0.0.1:{PORT}/mcp",
      "--header", "Authorization: Bearer ${{GW_AUTH}}"], "env": {{"GW_AUTH": "<token from: mcp-gateway client add claude-desktop>"}} }}
Quit + reopen Claude Desktop. Use a different key per PC ("mcp-{n}") so tools say which PC they run on.
""")
    if app in ("all", "claude-code"):
        print(f"""== Claude Code ==
  mcp-gateway client add claude-code        # prints a token
  claude mcp add --transport http mcp-{n} http://127.0.0.1:{PORT}/mcp --header "Authorization: Bearer <token>"
First use pops an approval on this PC; "Trust this client" = never asked again until revoked.
""")
    if app in ("all", "gemini"):
        print(f"""== Gemini web (needs the public HTTPS URL) ==
  1. mcp-gateway url https://<this-pc>.<tailnet>.ts.net:10000   (see README: Tailscale Funnel)
  2. Gemini -> Settings -> Connectors/MCP -> add custom connector:
       name: mcp-{n}      URL: {url or '<public url>'}/mcp      auth: OAuth
  3. Approve the popup that appears on THIS PC ("Approve & trust"). No popup = no access.
  4. In chats, @mention the connector name to load it.
""")
    if app == "other":
        print(f"Any MCP client: URL http://127.0.0.1:{PORT}/mcp with header Authorization: Bearer <client token>,\nor OAuth discovery at {url or '<public url>'}/.well-known/oauth-protected-resource")


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__); return
    c, rest = a[0], a[1:]
    table = {"name": cmd_name, "url": cmd_url, "backend": cmd_backend, "client": cmd_client, "trust": cmd_trust,
             "connect": cmd_connect, "status": cmd_status, "extension": lambda r: make_ext(r), "desktop": cmd_desktop, "funnel": cmd_funnel, "uninstall": cmd_uninstall, "remove": cmd_uninstall}
    if c in table:
        table[c](rest)
    elif c == "render":
        render(); print("rendered", CFG)
    elif c == "restart":
        render(); restart()
    elif c == "logs":
        os.execvp("journalctl", ["journalctl", "--user", "-u", "mcp-gateway", "-u", "mcp-gateway-approver", "-n", "80", "--no-pager"])
    else:
        die("unknown command; try: mcp-gateway help")


if __name__ == "__main__":
    main()
